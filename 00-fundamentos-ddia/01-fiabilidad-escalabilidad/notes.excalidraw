        }
      ],
      "updated": 1767410893565,
      "link": null,
      "locked": false,
      "text": "Un programador escribe una línea de\ncódigo que divide por cero (x / 0) en una\nfunción que casi nunca se usa. Ese código\ndefectuoso es el Fault.",
      "fontSize": 18.409781180179206,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un programador escribe una línea de código que divide por cero (x / 0) en una  función que casi nunca se usa. Ese código defectuoso es el Fault.",
      "autoResize": false,
      "lineHeight": 1.35
    },
