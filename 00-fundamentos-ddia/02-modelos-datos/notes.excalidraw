      "updated": 1767930699708,
      "link": null,
      "locked": false,
      "text": "-- ✨ LA MAGIA DE SQL:\n-- Si el profesor se cambia el nombre, ejecutas UNA sola línea:\nUPDATE Professors \nSET name = 'Dr. Pepe.' \nWHERE id = 99; \n-- ¡Y se actualiza automáticamente para todos los estudiantes!",
      "fontSize": 10.699649057227312,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- ✨ LA MAGIA DE SQL:\n-- Si el profesor se cambia el nombre, ejecutas UNA sola línea:\nUPDATE Professors \nSET name = 'Dr. Pepe.' \nWHERE id = 99; \n-- ¡Y se actualiza automáticamente para todos los estudiantes!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
