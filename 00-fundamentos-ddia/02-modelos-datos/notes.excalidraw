      "seed": 613007898,
      "version": 781,
      "versionNonce": 1017092870,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "TNRke4OMZEj-MIrJML0Xc",
          "type": "arrow"
        }
      ],
      "updated": 1767930664690,
      "link": null,
      "locked": false,
      "text": "-- 1. El Profesor vive en UN solo lugar (Single Source of Truth)\nCREATE TABLE Professors (\n    id INT PRIMARY KEY,\n    name VARCHAR(100) -- \"Dr. Juan Pérez\"\n);\n\n-- 2. El Curso solo guarda la referencia (ID)\nCREATE TABLE Courses (\n    id INT PRIMARY KEY,\n    title VARCHAR(100),\n    professor_id INT REFERENCES Professors(id) -- 🔗 Link\n);\n\n-- 3. El Estudiante se inscribe al curso (Tabla de unión)\nCREATE TABLE Student_Enrollments (\n    student_id INT,\n    course_id INT REFERENCES Courses(id)\n);\n\n",
      "fontSize": 10.710133464816268,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- 1. El Profesor vive en UN solo lugar (Single Source of Truth)\nCREATE TABLE Professors (\n    id INT PRIMARY KEY,\n    name VARCHAR(100) -- \"Dr. Juan Pérez\"\n);\n\n-- 2. El Curso solo guarda la referencia (ID)\nCREATE TABLE Courses (\n    id INT PRIMARY KEY,\n    title VARCHAR(100),\n    professor_id INT REFERENCES Professors(id) -- 🔗 Link\n);\n\n-- 3. El Estudiante se inscribe al curso (Tabla de unión)\nCREATE TABLE Student_Enrollments (\n    student_id INT,\n    course_id INT REFERENCES Courses(id)\n);\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
