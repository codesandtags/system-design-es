    {
      "id": "htIUcbRutPIx7C-HjSjKX",
      "type": "text",
      "x": -160.43411676369868,
      "y": 5371.957908270049,
      "width": 329.89971923828125,
      "height": 267.7533366204067,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
